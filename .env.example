# Copy this file to .env.local and replace the placeholders with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/winter_arc?retryWrites=true&w=majority
MONGODB_DB=winter_arc
# Generate a private random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-private-random-secret-at-least-32-characters-long
# Cloudinary is optional. These are needed only for image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
